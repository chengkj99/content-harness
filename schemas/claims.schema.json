{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "enum": [
            "experience",
            "observation",
            "factual",
            "quantitative",
            "prediction"
          ],
          "title": "Type",
          "type": "string"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Support"
          },
          "title": "Sources",
          "type": "array"
        },
        "status": {
          "enum": [
            "supported",
            "pending",
            "author-confirmed",
            "bounded"
          ],
          "title": "Status",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance"
        },
        "boundary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundary"
        },
        "protected_terms": {
          "items": {
            "type": "string"
          },
          "title": "Protected Terms",
          "type": "array"
        },
        "narrative_role": {
          "anyOf": [
            {
              "enum": [
                "scene",
                "conflict",
                "turn",
                "reflection",
                "context"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narrative Role"
        },
        "sensitivity": {
          "default": "normal",
          "enum": [
            "normal",
            "private",
            "sensitive"
          ],
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text",
        "type",
        "risk",
        "status"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Support": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "support": {
          "enum": [
            "direct",
            "partial",
            "contextual",
            "none"
          ],
          "title": "Support",
          "type": "string"
        },
        "checked_at": {
          "title": "Checked At",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "locator",
        "support",
        "checked_at"
      ],
      "title": "Support",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    }
  },
  "required": [
    "claims"
  ],
  "title": "Claims",
  "type": "object"
}
