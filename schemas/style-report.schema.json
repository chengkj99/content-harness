{
  "$defs": {
    "StyleRuleAssessment": {
      "additionalProperties": false,
      "properties": {
        "style_id": {
          "minLength": 1,
          "title": "Style Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "applied",
            "already-satisfied",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "style_id",
        "status",
        "evidence"
      ],
      "title": "StyleRuleAssessment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "input_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Hashes",
      "type": "object"
    },
    "changes": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Changes",
      "type": "array"
    },
    "rejected": {
      "items": {
        "type": "string"
      },
      "title": "Rejected",
      "type": "array"
    },
    "fidelity": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "Fidelity",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "rule_assessments": {
      "items": {
        "$ref": "#/$defs/StyleRuleAssessment"
      },
      "title": "Rule Assessments",
      "type": "array"
    }
  },
  "required": [
    "input_hashes",
    "changes",
    "rejected",
    "fidelity",
    "reason"
  ],
  "title": "StyleReport",
  "type": "object"
}
